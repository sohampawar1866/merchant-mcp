# ==============================================================================
# AgenticCheckout — Environment Configuration Template
# Copy this file to .env and fill in your test credentials.
# DO NOT commit real .env files to GitHub.
# ==============================================================================

# --- Razorpay Test API Credentials ---
# Obtain from https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# --- Server & Transport Configuration ---
# Options: streamablehttp (default for AI agents) | sse | stdio
MCP_TRANSPORT=streamablehttp
PORT=8080

# --- Host Port Mappings (Optional overrides) ---
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# UPI_CIRCLE_PORT=3002

# --- Database Master Encryption Passphrase ---
ENCRYPTION_PASSPHRASE=agentic_platform_master_passphrase_2026
