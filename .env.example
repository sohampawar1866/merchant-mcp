# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# Database
DATABASE_URL=postgres://agentic:agentic@localhost:5432/agentic_checkout?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=8080
MCP_TRANSPORT=stdio

# Feature Flags
ENABLE_FIND_AND_PRICE=true
ENABLE_NEGOTIATION=true
ENABLE_HUMAN_APPROVAL=false
MAX_NEGOTIATION_ATTEMPTS=3
ENABLE_CATALOG_CACHE=true
AUDIT_LOG_LEVEL=full
CHECKOUT_DELIVERY_MODE=payment_link
MAX_TOOL_CALLS_PER_MINUTE=30
WEBHOOK_STRICT_MODE=true
