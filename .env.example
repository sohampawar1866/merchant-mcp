# ==============================================================================
# AgenticCheckout — Unified Agentic Gateway Configuration Template
# Hosted by Razorpay / Multi-Tenant Platform Operator
# DO NOT commit real .env files to GitHub.
# ==============================================================================

# --- Platform Master Security Passphrase ---
# Used by PostgreSQL pgcrypto (AES-256) to symmetrically encrypt & decrypt
# all 100+ onboarded merchants' Razorpay API Key Secrets in the database.
ENCRYPTION_PASSPHRASE=agentic_platform_master_passphrase_2026

# --- MCP Gateway & Transport Configuration ---
# Protocol used by AI agents (Claude Desktop, Cursor, ChatGPT) to call tools:
#   - streamablehttp : Modern streaming HTTP POST protocol (Default)
#   - sse            : Server-Sent Events over HTTP
#   - stdio          : Standard I/O for local child process execution
MCP_TRANSPORT=streamablehttp
PORT=8080

# --- Host Port Mappings (Optional Overrides for Local Dev) ---
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# UPI_CIRCLE_PORT=3002

# --- Optional Single-Store Fallback (Local Dev Only) ---
# NOTE: In our multi-tenant architecture, merchants enter their credentials
# via the Merchant Dashboard (/onboard) or Platform Admin (:3001). Credentials
# are encrypted in PostgreSQL. The variables below are strictly optional
# fallbacks for running isolated single-store unit tests without the database.
# RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
# RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
# RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
