# ==============================================================================
# AgenticCheckout Configuration Template
# All application settings, credentials, and feature flags can be configured
# and edited LIVE from the Merchant Dashboard UI without restarting containers.
# ==============================================================================

# Infrastructure Connections
DATABASE_URL=postgres://agentic:agentic@localhost:5432/agentic_checkout?sslmode=disable
REDIS_URL=redis://localhost:6379

# Gateway Server Ports & Defaults
PORT=8080
MCP_TRANSPORT=streamablehttp

# Initial Razorpay Credentials (also editable live from Dashboard > Store Policies)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=agentic_checkout_secret_2026

# Store Guardrails & Feature Defaults (also editable live from Dashboard > Store Policies)
ENABLE_FIND_AND_PRICE=true
ENABLE_NEGOTIATION=true
ENABLE_HUMAN_APPROVAL=false
MAX_NEGOTIATION_ATTEMPTS=3
MAX_DISCOUNT_PERCENT=20
MAX_TOOL_CALLS_PER_MINUTE=30
ENABLE_CATALOG_CACHE=true
AUDIT_LOG_LEVEL=full
CHECKOUT_DELIVERY_MODE=payment_link
WEBHOOK_STRICT_MODE=true
